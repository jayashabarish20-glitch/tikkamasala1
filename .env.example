# ============================================================
# TIKKA MASALA CHAT CORNER — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/tikkamasala

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Admin Seed ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@tikkamasala.com

# --- Shop Location (for 5 km delivery validation) ---
SHOP_LATITUDE=13.096627
SHOP_LONGITUDE=80.259209
DELIVERY_RADIUS_KM=5

# --- Delivery Charge (in INR) ---
DELIVERY_CHARGE=30

# --- Razorpay (get test keys from dashboard.razorpay.com) ---
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- SMS Provider (mock / msg91 / twilio) ---
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=TIKKA

# --- Demo / Development Mode ---
DEMO_MODE=true

# --- AWS (for production only) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=tikkamasala-images
USE_S3=false

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5500

# --- Firebase Cloud Messaging (FCM) for admin phone push notifications ---
# Backend: Path to Firebase service account JSON file (backend-only, never commit this file)
FIREBASE_SERVICE_ACCOUNT_JSON="C:\secure\tikhamasala-d495a-firebase-adminsdk-fbsvc-e8edb8634f.json"
